PORT=5000
SUPABASE_URL=your_supabase_url
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
JWT_SECRET=your_jwt_secret_key_here

# Email — Google Apps Script relay (HTTPS, works on Render free tier)
# 1. Go to script.google.com → create a new project with doPost() function
# 2. Deploy → New deployment → Web App (Execute as: Me, Access: Anyone)
# 3. Copy the Web App URL and paste it here
APPS_SCRIPT_URL=your_google_apps_script_web_app_url_here

CLIENT_URL=https://your-frontend.vercel.app
